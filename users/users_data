from pathlib import Path
from string import Template
from email.mime.text import MIMEText
from email.mime.multipart import MIMEMultipart

# ________________________________________________________
html_template = Template("""\
<html>
<body style="color: #333333;">
    <p>Здравствуйте, $name!</p>
    <p>Внедрен корпоративный мессенжер <b>Element</b> для общения и обмена информацией внутри организации!</p>
    <p>Приложение можно установить как на ваш смартфон, так и рабочий ПК.</p>
    <p>Инструкция по установке во вложении.</p>
    <hr>
    <p>Ниже указаны ваши данные для входа в приложение.</p>
    <p>Ваш логин: <b>$login</b></p>
    <p>Ваш временный пароль: <b>$passwd</b></p>
    <p>Адрес сервера:</p>
    <hr>
    <p>По всем вопросам просьба обращаться в ИТ отдел.</p>
    <p>HelpDesk:</p>
</body>
</html>
""")
# ________________________________________________________   <p>$email</p>

OUTPUT_DIR = Path("./outlook_drafts")
OUTPUT_DIR.mkdir(exist_ok=True)

class Users:
    def __init__(self, file_name):
        self.users = []
        self._load()

    def _load(self):
        with open(file_name, 'r', encoding='utf-8') as file:
            for i, line in enumerate(file):
                if i == 0:
                    continue
                parts = line.strip().split(';')
                if len(parts) == 4:
                    user_data = {
                        "name": parts[0],
                        "login": parts[1],
                        "email": parts[2],
                        "passwd": parts[3]
                    }
                    self.users.append(user_data)

    def read(self):
        for date in self.users:
            create_msg(date)

def create_msg(date):
    msg = MIMEMultipart("mixed")
    msg["Subject"] = f"Важно! Информационное сообщение от отдела ИТ!"
    msg["From"] = ''
    msg["To"] = date["email"]

    html_content = html_template.substitute(date)
    msg.attach(MIMEText(html_content, "html", "utf-8"))

    safe_email = date["email"].replace("@", "_at_")
    filename = f"{safe_email}.eml"
    filepath = OUTPUT_DIR / filename

    with open(filepath, "w", encoding="utf-8") as f:
        f.write(msg.as_string())

    print(f"Сохранено: {filepath}")

if __name__ == '__main__':
    print('Файл должен быть формата csv utf-8 разделитель - запятая\nФайл нужно поместить туда же где и находится скрипт')
    print('Укажите полное имя файла с форматом:')
    file_name = input()

    users = Users(file_name)
    users.read()

    print(f"Все файлы сохранены в папке: {OUTPUT_DIR.absolute()}")
